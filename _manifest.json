{
  "manifest_version": 2,
  "id": "com.fsqhn.image-searcher",
  "version": "0.7.9",
  "name": "麦麦寻人",
  "description": "把群里的图片反查原始出处与社交账号：Google Lens / Yandex / 百度 / SauceNAO 多引擎搜索，用图片指纹验证是否同一张图；指纹全灭时并行走视觉复核与 Grok 核对候选。也可以叫「麦麦找鸡」——本质一样，都是按图找出处和账号。输出平台、匹配方式、名字与账号，并附 AI 生成概率参考。",
  "author": {
    "name": "fsqhn",
    "url": "https://github.com/fsqhn"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/fsqhn/com.fsqhn.image-searcher"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.9.999"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "999.999.999"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    },
    {
      "type": "python_package",
      "name": "requests",
      "version_spec": ">=2.31.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.forward",
    "message.get_by_id",
    "message.get_recent",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "scan-search"
    }
  }
}
